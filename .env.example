# Optional canonical public address. Set when using a custom domain.
PUBLIC_SITE_URL=

# Public Supabase settings (existing project values)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Private SMTP settings, only on the server. Never prefix with PUBLIC_.
# Use an application/service sender, not the recipient's personal mailbox password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ttrpg.parma@gmail.com
SMTP_PASS=
# Verified/allowed sender address for this SMTP account.
FEEDBACK_FROM="Парма <ttrpg.parma@gmail.com>"
# Optional private recipient. Defaults to SMTP_USER if it is an email address.
FEEDBACK_TO=
